# Copy to .env — see docs/SUPABASE_SETUP.md

# --- Remote Supabase project (recommended for shared dev/staging) ---
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Server-only. Never expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Direct Postgres connection (migrations, supabase db push). Port 5432.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres"

# --- Local Supabase (optional — npx supabase start) ---
# After `npm run supabase:start`, run `npm run supabase:status` and paste values:
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
