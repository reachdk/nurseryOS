# Copy to .env and fill in — see docs/SUPABASE_SETUP.md

# From dashboard: Connect → Transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# From dashboard: Connect → Direct connection (port 5432) — migrations only
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres"

# From dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Optional: GET /api/debug/inventory?secret=... (bypasses login for production diagnostics)
INVENTORY_DEBUG_SECRET=""
